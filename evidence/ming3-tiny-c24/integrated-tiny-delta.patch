+    )
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    torch.testing.assert_close(hidden_states, before, rtol=0, atol=0)
+    actual.zero_()
+    torch.testing.assert_close(hidden_states, before, rtol=0, atol=0)
