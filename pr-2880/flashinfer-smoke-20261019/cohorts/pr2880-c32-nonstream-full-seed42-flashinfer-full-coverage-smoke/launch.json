{
  "command": [
    "/opt/sglang/bin/python",
    "-m",
    "sglang_omni.cli",
    "serve",
    "--config",
    "/qualification/results/pr2880-c32-nonstream-full-seed42-flashinfer-full-coverage-smoke/config.yaml",
    "--model-name",
    "Qwen/Qwen3-ASR-1.7B",
    "--host",
    "127.0.0.1",
    "--port",
    "56219",
    "--skip-server-warmup"
  ],
  "source": "/qualification/source/pr-2880",
  "config": {
    "config_cls": "Qwen3ASRPipelineConfig",
    "model_path": "/qualification/assets/model",
    "stages": {
      "asr": {
        "gpu": 0,
        "factory": {
          "dtype": "bfloat16",
          "pre_lm_cache_size_bytes": 1,
          "mm_embedding_cache_size_bytes": 0
        },
        "engine": {
          "disable_radix_cache": true,
          "random_seed": 42,
          "attention_backend": "flashinfer"
        }
      }
    }
  },
  "seed": 42,
  "mode": "nonstream",
  "concurrency": 32,
  "arm": "full",
  "environment_overrides": {
    "SGLANG_ENABLE_METADATA_GLUE_GRAPH": "0"
  }
}