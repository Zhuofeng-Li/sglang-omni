{
  "command": [
    "/opt/sglang/bin/python",
    "-m",
    "sglang_omni.cli",
    "serve",
    "--config",
    "/qualification/results/pr2881-c32-nonstream-scoped_admission-seed42-async-admission-ablation/config.yaml",
    "--model-name",
    "Qwen/Qwen3-ASR-1.7B",
    "--host",
    "127.0.0.1",
    "--port",
    "45979",
    "--skip-server-warmup"
  ],
  "source": "/qualification/source/pr-2881",
  "config": {
    "config_cls": "Qwen3ASRPipelineConfig",
    "model_path": "/qualification/assets/model",
    "stages": {
      "asr": {
        "gpu": 0,
        "factory": {
          "dtype": "bfloat16",
          "pre_lm_cache_size_bytes": 1,
          "mm_embedding_cache_size_bytes": 0
        },
        "engine": {
          "disable_radix_cache": true,
          "random_seed": 42
        }
      }
    }
  },
  "seed": 42,
  "mode": "nonstream",
  "concurrency": 32,
  "arm": "scoped_admission",
  "environment_overrides": {}
}